# En desarrollo la API corre aparte (puerto 4000). En producción (Railway,
# un solo servicio) NO definas esta variable: el default es /api (mismo origen).
VITE_API_URL=http://localhost:4000/api

# Client ID de OAuth 2.0 de Google (el mismo que GOOGLE_CLIENT_ID del backend).
# Vacío = el botón "Continuar con Google" no se renderiza.
VITE_GOOGLE_CLIENT_ID=
