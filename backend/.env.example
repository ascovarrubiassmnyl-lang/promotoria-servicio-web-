DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm_promotoria?schema=public"
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development

# Acceso con Google (Google Identity Services). Client ID de OAuth 2.0 tipo
# "Web application" creado en Google Cloud Console; debe ser el MISMO valor
# que VITE_GOOGLE_CLIENT_ID del frontend. Vacío = botón de Google desactivado.
GOOGLE_CLIENT_ID=

# Solo producción: el seed crea el super admin real con estas credenciales
# (create-only: si la cuenta ya existe no la toca). Mínimo 8 caracteres.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# VAPID keys (genera con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUBLIC_URL=http://localhost:5173
