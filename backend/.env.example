DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm_promotoria?schema=public"
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development

# Google Identity Services. Client ID de OAuth 2.0 tipo "Web application"
# creado en Google Cloud Console; debe ser el MISMO valor que
# VITE_GOOGLE_CLIENT_ID del frontend. Solo se usa para redimir invitaciones
# (/invitacion/:token) — no hay login recurrente con Google. Vacío = ese paso
# queda deshabilitado (503) y la invitación no se puede redimir.
GOOGLE_CLIENT_ID=

# Solo producción: el seed crea el super admin real con estas credenciales
# (create-only: si la cuenta ya existe no la toca). Mínimo 8 caracteres.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# VAPID keys (genera con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUBLIC_URL=http://localhost:5173

# SMTP para el correo automático de invitación (Asesores → Equipo → nuevo
# usuario). Vacío = no se envía correo, pero el link de invitación siempre
# se puede copiar y compartir a mano desde el modal. Con Gmail: activa
# verificación en dos pasos y usa una "contraseña de aplicación" como
# SMTP_PASS (no la contraseña normal de la cuenta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Gemini (genera la key gratis en https://aistudio.google.com/apikey).
# Se usa SOLO para analizar el PDF de una póliza subida desde "Nueva póliza"
# → "Subir documento" y prellenar la ficha técnica (nunca se guarda nada sin
# que el asesor lo confirme). Vacío = el botón de análisis queda
# deshabilitado con aviso; subir/ver/descargar el PDF sigue funcionando igual.
GEMINI_API_KEY=

# Opcional: fija a mano el modelo de Gemini, saltándose la lista de
# candidatos de services/extraccionPoliza.js (hoy gemini-3.6-flash →
# gemini-3.5-flash → gemini-2.5-flash, se prueban en ese orden y se usa el
# primero que responda). Solo hace falta si Google retira TODOS los de la
# lista: entonces se pone aquí uno vigente sin tener que redeployar código.
GEMINI_MODELO=

# Banxico SIE (token gratuito en
# https://www.banxico.org.mx/SieAPIRest/service/v1/token).
# Se usa para el tipo de cambio oficial del día con el que las pólizas en
# dólares o UDIS se convierten a pesos: serie SF43718 (FIX, pesos por dólar) y
# SP68257 (valor de la UDI). El asesor NUNCA captura el tipo de cambio a mano
# (2026-08-15): esta conversión la resuelve el servidor solo, con Banxico o,
# si no responde, con el respaldo manual de abajo.
BANXICO_TOKEN=

# Respaldo manual del tipo de cambio: se usa SOLO si Banxico no responde (sin
# BANXICO_TOKEN, caído, o sin publicar ese día). El usuario tiene su propia
# alerta que le avisa cuando cambia el valor de la UDI/USD y actualiza estos
# valores a mano — no hay integración automática para esto, es intencional.
# Sin ninguno de los dos (ni Banxico ni respaldo), una póliza en USD/UDI no se
# puede guardar hasta que se configure uno: es preferible a inventar una
# paridad y calcular mal una comisión.
TIPO_CAMBIO_USD_RESPALDO=
TIPO_CAMBIO_UDI_RESPALDO=
