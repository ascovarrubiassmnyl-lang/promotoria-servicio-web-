generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  SUPERADMIN
  ADMIN
  ASESOR
}

// Pipeline de ventas de la promotora (8 etapas)
// Sustituye al enum anterior POTENCIAL/NEGOCIACION/ACTIVO/INACTIVO/CERRADO.
// Migración mapea: POTENCIAL->PROSPECTO, NEGOCIACION->PROPUESTA, ACTIVO->ENTREGA_POLIZA, CERRADO->CIERRE_FIRMA, INACTIVO->NECESITA_SEGUIMIENTO
enum EstadoCliente {
  PROSPECTO
  CITA
  PROPUESTA
  CIERRE_FIRMA
  ENTREGA_POLIZA
  REFERIDOS
  POST_VENTA_SEGUIMIENTO
  NECESITA_SEGUIMIENTO
}

enum EstadoCita {
  PROGRAMADA
  CONFIRMADA
  COMPLETADA
  CANCELADA
  NO_ASISTIO
}

enum TipoCita {
  TELEFONICA
  VIDEO
  PRESENCIAL
}

// Modalidad de la cita:
//  ACOMPANAMIENTO       = cita compartida asesor+promotor (el promotor acompaña al asesor).
//  CITA_UNICA           = cita normal del asesor, sin promotor presente.
//  ENTREGA_POLIZA       = cita para entregar la póliza emitida al cliente.
//  PRP/ENTREVISTA_*     = agenda propia de reclutamiento del promotor: no
//                         llevan asesor ni cliente (ver backend/src/routes/citas.js).
enum ModalidadCita {
  CITA_UNICA
  ACOMPANAMIENTO
  ENTREGA_POLIZA
  PRP
  ENTREVISTA_INICIAL
  ENTREVISTA_SELECCION
  ENTREVISTA_CARRERA
}

// Clasificación de la agenda por lo que aporta al negocio (metodología de la
// promotoría): el COLOR del evento en el calendario sale de aquí, no del canal.
//  PRODUCTIVA = genera dinero (cita de venta, cierre, entrega)      → verde
//  GESTION    = trabajo que no genera dinero directo (seguimiento)  → amarillo
//  PERSONAL   = asunto personal del asesor (bloquea agenda)         → rojo
enum ClasificacionCita {
  PRODUCTIVA
  GESTION
  PERSONAL
}

// Respuesta del promotor a la invitación de acompañar una cita. Mientras esté
// PENDIENTE la cita no ocupa su agenda; ACEPTADA la vuelve firme (y sí bloquea);
// RECHAZADA la libera y el asesor debe buscar otro promotor u horario;
// SUGERIDA = el promotor propuso otro horario (ver Cita.sugerenciaInicio/Fin) y
// espera que el asesor la acepte o la descarte — tampoco bloquea la agenda.
enum EstadoInvitacionCita {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  SUGERIDA
}

// ——— Módulo de Candidatos (reclutamiento de asesores) ———
// Pipeline del proceso de selección SMNYL. ENTREVISTA_ADICIONAL es opcional:
// al avanzar desde CARRERA se puede saltar directo a PRECONTRATO_MC.
enum EtapaCandidato {
  ENTREVISTA_INICIAL
  SELECCION
  CARRERA
  ENTREVISTA_ADICIONAL
  PRECONTRATO_MC
  FIRMA_CONTRATO_FC
}

// Resultado de la evaluación vitales+valores. NO se captura a mano: lo calcula
// el servidor (utils/semaforoCandidato.js, única implementación de la regla)
// al completar los valores.
enum SemaforoCandidato {
  SIN_EVALUAR
  VERDE
  AMARILLO
  ROJO
}

// Estado del ciclo de una venta en el pipeline financiero
enum EstadoVenta {
  PENDIENTE_PAGAR
  FIRMADA
  PAGADA
  CANCELADA
  APROBADA // alias legacy para ventas ya validadas del periodo anterior
  RECHAZADA
}

// Promotoría NY Life — seguros para personas únicamente
enum RamoSeguro {
  VIDA
  ACUMULACION
  PROTECCION
  SALUD
  RETIRO
  GMM
}

enum TipoNota {
  NOTA
  RECORDATORIO
  RECORDATORIO_PAGO
}

// A quién apunta un recordatorio. OJO: el CRM no tiene canal hacia el
// asegurado (no manda WhatsApp ni correo al cliente), así que CLIENTE no
// significa "avisarle al cliente" sino "el asesor debe contactar al cliente
// por esto" — se le notifica igual al asesor, con etiqueta distinta.
enum DestinatarioNota {
  ASESOR
  CLIENTE
}

// Moneda en la que está denominada la póliza. `Venta.primaAnual` SIEMPRE está
// en MXN (todas las métricas, comisiones, metas y rankings la suman); estos
// campos guardan el monto original y el tipo de cambio usado para convertirlo.
enum MonedaPoliza {
  MXN
  USD
  UDI
}

// Medio con el que el cliente paga la póliza.
enum MetodoPagoPoliza {
  TARJETA_CREDITO
  TARJETA_CREDITO_MSI
  TARJETA_DEBITO
  TRANSFERENCIA
  EFECTIVO
  CARGO_NOMINA
}

// Resultado de un cobro registrado sobre la póliza (semáforo del historial).
enum EstadoPagoPoliza {
  PAGADO
  PENDIENTE
  CANCELADO
}

// Forma de pago de la prima
enum FormaPago {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  UNICO
}

model Usuario {
  id            String     @id @default(cuid())
  nombre        String
  apellidoP     String
  apellidoM     String?
  email         String     @unique
  password      String
  telefono      String?
  rol           RolUsuario @default(ASESOR)
  activo        Boolean    @default(true)
  fotoUrl       String?
  // LEGACY, sin uso: las excepciones por usuario se eliminaron (el acceso es
  // solo por rol, ver PoliticaRol). Nadie lee ni escribe este campo.
  permisos      Json?
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  clientes              Cliente[]
  citas                 Cita[]
  citasPromotor         Cita[]                @relation("citasPromotor")
  ventasAsesor          Venta[]               @relation("ventasAsesor")
  ventasValidador       Venta[]               @relation("ventasValidador")
  pagosRegistrados      PagoPoliza[]          @relation("pagosRegistrados")
  actividad             Actividad[]
  targets               Target[]
  notas                 Nota[]
  pushSubs              PushSubscription[]
  notificaciones        Notificacion[]
  googleCalendar        GoogleCalendarCuenta?
  referidos             Referido[]
  bonos                 Bono[]
  documentos            DocumentoCliente[]
  permisoLogs           PermisoLog[]
  invitacion            InvitacionUsuario?
  registrosPuntos       RegistroPuntos[]
  planesSemana          PlanSemanal[]
  prospectosClinica     ProspectoClinica[]
  sesionesClinica       SesionClinica[]
  candidatosCreados     Candidato[]           @relation("candidatosCreados")
  candidatosReclutados  Candidato[]           @relation("candidatosReclutados")
  evaluacionesCandidato EvaluacionCandidato[]
  popPlantillas         PopPlantilla[]
  popEnvios             PopEnvio[]
}

// Invitación de un solo uso para activar una cuenta creada sin contraseña
// (alta pensada para acceso exclusivo con Google). El registro público con
// Google está cerrado (ver /api/auth/google): solo un promotor/superadmin
// puede crear el perfil (Asesores → Equipo) y generar este link; se comparte
// fuera del sistema (WhatsApp, correo) y se redime en /invitacion/:token,
// donde el correo de la cuenta de Google debe coincidir con el del perfil.
model InvitacionUsuario {
  id          String    @id @default(cuid())
  usuarioId   String    @unique
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  token       String    @unique
  expiraEn    DateTime
  usadaEn     DateTime?
  creadoPorId String?
  creadoEn    DateTime  @default(now())
}

// Acceso base por rol a cada sección (RBAC). `accesos` es Json {seccion: boolean}.
// Fuente de verdad del control de acceso: el acceso efectivo de un usuario es
// su override (Usuario.permisos[seccion]) si existe, si no el del rol, y si no
// hay política se DENIEGA (fail closed). SUPERADMIN no se consulta aquí:
// siempre tiene acceso total (hardcodeado en middleware/permisos.js, anti-lockout).
model PoliticaRol {
  id            String     @id @default(cuid())
  rol           RolUsuario @unique
  accesos       Json
  actualizadoEn DateTime   @updatedAt
}

// Bitácora de cambios de control de acceso: quién cambió qué, cuándo y sobre quién.
// accion: ROL_POLITICA | EXCEPCION_USUARIO | ROL_USUARIO | USUARIO_CREADO.
// detalle: { rol?, seccion?, usuarioId?, usuarioNombre?, antes?, ahora? }.
// actorNombre se guarda desnormalizado para que el registro sobreviva bajas.
model PermisoLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       Usuario? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorNombre String
  accion      String
  detalle     Json
  creadoEn    DateTime @default(now())

  @@index([creadoEn])
}

// Suscripción Web Push de un usuario (un usuario puede tener varias: móvil, escritorio).
// Conexión con Google Calendar por usuario (2026-08). Cada persona conecta su
// propia cuenta desde Configuración (OAuth con consentimiento); guardamos el
// refresh token para poder escribir eventos en su calendario sin que vuelva a
// autorizar. Desconectar = borrar la fila (y revocar en Google).
model GoogleCalendarCuenta {
  id            String    @id @default(cuid())
  usuarioId     String    @unique
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Correo de la cuenta de Google conectada (informativo para la UI).
  email         String
  refreshToken  String
  accessToken   String?
  expiraEn      DateTime?
  // Calendario destino; "primary" = el principal de esa cuenta.
  calendarId    String    @default("primary")
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
}

model PushSubscription {
  id             String   @id @default(cuid())
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint       String
  // Claves p256dh y auth en base64url, como las envía el navegador en subscription.toJSON()
  p256dh         String
  auth           String
  // Expiration endpoint opcional (some browsers)
  expirationTime Int?
  creadoEn       DateTime @default(now())

  @@unique([endpoint])
  @@index([usuarioId])
}

// Notificación in-app: fuente de verdad de todo aviso que hoy también dispara
// push (invitación de acompañamiento, respuestas, recordatorios). Se crea
// SIEMPRE antes de intentar el push (ver utils/notificaciones.js) — así el
// aviso nunca se pierde aunque la suscripción push falle o no exista. Cada
// usuario ve EXCLUSIVAMENTE las suyas (destinatarioId = req.user.id, sin
// excepción de admin: es dato personal, como PushSubscription, no una
// sección RBAC).
model Notificacion {
  id             String    @id @default(cuid())
  destinatarioId String
  destinatario   Usuario   @relation(fields: [destinatarioId], references: [id], onDelete: Cascade)
  // Tipo canónico (string, no Prisma enum — mismo criterio que Actividad.tipo).
  // Única fuente: TIPOS_NOTIFICACION en backend/src/utils/notificaciones.js.
  tipo           String
  titulo         String
  cuerpo         String
  // Contexto para navegación/presentación: url, citaId, notaId, clienteId, ventaId…
  datos          Json?
  leida          Boolean   @default(false)
  leidaEn        DateTime?
  // Diagnóstico del intento de push asociado (no bloquea nada, solo para
  // depurar suscripciones rotas / VAPID mal configurada).
  pushIntentado  Boolean   @default(false)
  pushEnviado    Boolean   @default(false)
  creadoEn       DateTime  @default(now())

  @@index([destinatarioId, leida, creadoEn])
}

model Cliente {
  id                  String        @id @default(cuid())
  asesorId            String
  asesor              Usuario       @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  nombre              String
  apellidoP           String
  apellidoM           String?
  email               String?
  telefono            String?
  fechaNacimiento     DateTime?
  rfc                 String?
  curp                String?
  direccion           String?
  estado              EstadoCliente @default(PROSPECTO)
  // Bandera independiente de la etapa: un cliente puede estar en cualquier
  // etapa Y necesitar seguimiento a la vez. (El valor NECESITA_SEGUIMIENTO del
  // enum es legacy: se migró a esta bandera y ya no debe usarse como etapa.)
  necesitaSeguimiento Boolean       @default(false)
  notas               String?
  fuente              String?
  // Borrado lógico: DELETE /api/clientes/:id archiva (setea esta fecha) en vez
  // de borrar; pólizas, citas y referidos se conservan. null = cliente activo.
  archivadoEn         DateTime?
  creadoEn            DateTime      @default(now())
  actualizadoEn       DateTime      @updatedAt

  // Producto de interés (cuando el cliente está en prospección)
  productoInteres      RamoSeguro?
  detalleInteres       String?
  // Si ya compró
  productoComprado     RamoSeguro?
  productoNombre       String? // nombre específico del producto NY Life
  formaPago            FormaPago?
  primaMonto           Float?
  fechaInicioCobertura DateTime?
  fechaRenovacion      DateTime?

  // Gestión de cartera: última llamada y última cita registradas
  fechaUltimaLlamada DateTime?
  fechaUltimaCita    DateTime?

  // Referidos: quién refirió a este cliente (opcional, auto-referencia)
  referidoPorId String?
  referidoPor   Cliente?  @relation("Referidos", fields: [referidoPorId], references: [id])
  referidos     Cliente[] @relation("Referidos")

  citas                 Cita[]
  ventas                Venta[]
  notasItems            Nota[]
  referidosOrigen       Referido[]         @relation("ReferidosOrigen")
  referidosComoReferido Referido[]         @relation("ReferidosCliente")
  documentos            DocumentoCliente[]
  prospectosClinica     ProspectoClinica[]

  @@index([asesorId, estado])
  @@index([referidoPorId])
}

model Cita {
  id                     String                @id @default(cuid())
  asesorId               String
  asesor                 Usuario               @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  // Opcional: un evento PERSONAL (bloqueo de agenda) no tiene cliente. Toda
  // cita de trabajo sí lo exige (validado en la ruta, no aquí).
  clienteId              String?
  cliente                Cliente?              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // Solo citas de reclutamiento (PRP/ENTREVISTA_*): candidato entrevistado.
  // Opcional (una PRP grupal puede no tener candidato); excluyente con clienteId
  // según la modalidad — validado en la ruta, no aquí.
  candidatoId            String?
  candidato              Candidato?            @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  titulo                 String
  descripcion            String?
  tipo                   TipoCita              @default(TELEFONICA)
  modalidad              ModalidadCita         @default(CITA_UNICA)
  clasificacion          ClasificacionCita     @default(PRODUCTIVA)
  // Para ACOMPANAMIENTO: promotor (admin) que acompaña al asesor (opcional)
  promotorId             String?
  promotor               Usuario?              @relation("citasPromotor", fields: [promotorId], references: [id], onDelete: SetNull)
  // Invitación al promotor (2026-08): mientras esté PENDIENTE la cita NO
  // bloquea la agenda del promotor (no cuenta para sus empalmes) y le aparece
  // como "por confirmar"; solo al ACEPTADA se vuelve firme. Null = no hay
  // invitación (cita sin promotor o creada antes de esta función).
  invitacionEstado       EstadoInvitacionCita?
  invitacionRespondidaEn DateTime?
  // Sugerencia de otro horario (2026-08): el promotor invitado propone un
  // horario distinto en vez de aceptar/rechazar tal cual. Solo tienen sentido
  // mientras invitacionEstado = SUGERIDA; se limpian al aceptar/rechazar (por
  // el asesor) o al volver a invitar. La cita conserva su fechaHoraInicio/Fin
  // original hasta que el asesor acepta la sugerencia (ahí sí se mueve).
  sugerenciaInicio       DateTime?
  sugerenciaFin          DateTime?
  sugerenciaNota         String?
  // Id del evento espejo en el Google Calendar del promotor (2026-08). Se crea
  // al ACEPTAR la invitación y se borra al rechazar/cancelar. Null = no hay
  // evento en Google (no conectó su cuenta o no aplica).
  googleEventId          String?
  googleEventUsuarioId   String?
  estado                 EstadoCita            @default(PROGRAMADA)
  fechaHoraInicio        DateTime
  fechaHoraFin           DateTime
  ubicacion              String?
  recordatorioMinutos    Int                   @default(60)
  // Cita repetida (2026-08): las instancias generadas por una regla de
  // recurrencia comparten este id, solo informativo — cada cita se edita,
  // reagenda o cancela de forma independiente, sin lógica de cascada entre
  // ellas. Null = cita suelta (no repetida).
  serieId                String?
  creadoEn               DateTime              @default(now())
  actualizadoEn          DateTime              @updatedAt

  @@index([asesorId, fechaHoraInicio])
  @@index([clienteId])
  @@index([candidatoId])
  @@index([promotorId])
  @@index([serieId])
}

// ——— Módulo de Candidatos (reclutamiento) ———
// CRM de perfiles de personas que podrían entrar al proceso de volverse
// asesores. Dueño del módulo: la promotora (sección RBAC `candidatos`, solo
// ADMIN/SUPERADMIN); cualquier rol puede CAPTURAR un candidato (un asesor
// puede referir), por eso se guarda quién lo creó.
model Candidato {
  id           String   @id @default(cuid())
  creadoPorId  String
  creadoPor    Usuario  @relation("candidatosCreados", fields: [creadoPorId], references: [id], onDelete: Cascade)
  // Reclutador asignado (usuario del sistema, opcional) + oficina texto libre,
  // como el formato SMNYL.
  reclutadorId String?
  reclutador   Usuario? @relation("candidatosReclutados", fields: [reclutadorId], references: [id], onDelete: SetNull)
  oficina      String?

  // Datos personales (paso 1 del formulario SMNYL)
  nombre          String
  apellidoP       String
  apellidoM       String?
  telefono        String
  ciudad          String?
  email           String?
  fechaNacimiento DateTime?
  sexo            String? // "M" | "F" (validado en la ruta)
  rfc             String?
  fuente          String // requerido en SMNYL (de dónde salió el candidato)
  referidoPor     String? // texto libre, quién lo refirió
  notas           String?

  // Información adicional (sección colapsable del formulario)
  calle                String?
  colonia              String?
  codigoPostal         String?
  estadoDireccion      String?
  profesion            String?
  gradoEstudios        String?
  antiguedadResidencia String?
  estadoCivil          String?
  numeroHijos          Int?
  ingresosAnuales      Float?

  etapa    EtapaCandidato    @default(ENTREVISTA_INICIAL)
  semaforo SemaforoCandidato @default(SIN_EVALUAR)

  evaluacion EvaluacionCandidato?

  // Borrado lógico, mismo patrón que Cliente: DELETE archiva, no borra.
  archivadoEn   DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  citas     Cita[]
  // Notas y recordatorios de seguimiento del reclutador. Se llama distinto del
  // campo `notas` de arriba, que es el texto libre del formulario SMNYL.
  notasSeguimiento Nota[]     @relation("notasSeguimiento")
  popEnvios        PopEnvio[]

  @@index([etapa])
  @@index([reclutadorId])
  @@index([creadoPorId])
}

// ─── POP propio de la promotoría ──────────────────────────────────────────
// El POP Screen real de SMNYL lo aplica un tercero (Selection Testing
// Consultants) con su propio instrumento y algoritmo: esto NO lo replica ni
// lo sustituye. Es el cuestionario de la promotora — ella arma las preguntas,
// asigna los puntos de cada opción y define los umbrales del semáforo, así
// que el puntaje es transparente y auditable, no una caja negra.

enum EstadoPopEnvio {
  PENDIENTE  // enviado, el candidato aún no lo abre/termina
  RESPONDIDO // el candidato contestó: ya hay puntaje
  CANCELADO  // la promotora lo invalidó (link muerto)
}

// Recomendación derivada del puntaje, con los mismos 3 niveles y el mismo
// lenguaje del semáforo del POP oficial (Proceder / Precaución / No proceder).
enum RecomendacionPop {
  PROCEDER
  PRECAUCION
  NO_PROCEDER
}

model PopPlantilla {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?
  // Preguntas embebidas como Json (no tabla por pregunta): una plantilla se
  // edita y versiona como un documento completo, y las respuestas guardan su
  // propia copia — cambiar la plantilla nunca debe alterar un POP ya contestado.
  // Shape: [{ id, texto, ayuda?, bloque?, tipo: 'OPCION'|'ESCALA'|'TEXTO',
  //           opciones: [{ id, texto, puntos }] }]
  preguntas   Json    @default("[]")
  // Umbrales del semáforo sobre el puntaje normalizado 0–100. Verde ≥
  // umbralVerde; amarillo ≥ umbralAmarillo; abajo, rojo.
  umbralVerde    Int @default(70)
  umbralAmarillo Int @default(40)

  // Una plantilla archivada no se ofrece para enviar, pero sus envíos previos
  // siguen íntegros (mismo borrado lógico que Cliente/Candidato).
  archivadaEn DateTime?

  creadoPorId String
  creadoPor   Usuario  @relation(fields: [creadoPorId], references: [id], onDelete: Cascade)
  envios      PopEnvio[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([creadoPorId])
}

model PopEnvio {
  id          String    @id @default(cuid())
  candidatoId String
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  plantillaId String
  plantilla   PopPlantilla @relation(fields: [plantillaId], references: [id], onDelete: Restrict)

  // Link público de un solo uso, mismo patrón que InvitacionUsuario: el
  // candidato no tiene cuenta en el CRM y contesta desde su celular.
  token    String         @unique
  expiraEn DateTime
  estado   EstadoPopEnvio @default(PENDIENTE)

  // Copia congelada de las preguntas al momento de enviar: si la promotora
  // edita la plantilla después, este POP conserva lo que la persona realmente
  // vio (mismo criterio que Venta.coberturas, que es copia y no referencia).
  preguntas Json @default("[]")
  // Respuestas del candidato: [{ preguntaId, opcionId?, texto?, puntos }]
  respuestas Json @default("[]")

  // Resultado calculado en servidor al contestar (nunca lo manda el cliente).
  puntaje        Int?              // normalizado 0–100
  puntosObtenidos Int?             // crudo, para poder mostrar "34 de 50"
  puntosPosibles  Int?
  recomendacion  RecomendacionPop?
  // Desglose por bloque: [{ bloque, puntos, posibles, porcentaje }] — es lo
  // que dibuja las barras tipo "ADN en Ventas" del reporte.
  bloques        Json              @default("[]")

  respondidoEn DateTime?
  abiertoEn    DateTime?

  enviadoPorId String
  enviadoPor   Usuario  @relation(fields: [enviadoPorId], references: [id], onDelete: Cascade)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([candidatoId])
  @@index([plantillaId])
  @@index([estado])
}

// Evaluación en dos pasos del candidato (formato SMNYL): 6 vitales → 6 valores,
// escala 0 = sin contestar, 1–5 = Pobre/Promedio/Bueno/Muy bueno/Excelente.
// Un paso se considera completo cuando sus 6 dimensiones son ≥1; los valores
// solo se capturan con vitales completos (flujo secuencial). Al completar los
// valores el servidor calcula y persiste Candidato.semaforo.
model EvaluacionCandidato {
  id          String    @id @default(cuid())
  candidatoId String    @unique
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  evaluadorId String
  evaluador   Usuario   @relation(fields: [evaluadorId], references: [id], onDelete: Cascade)

  // Vitales (1–5)
  caracterIntegridad     Int @default(0)
  agilidadMental         Int @default(0)
  empuje                 Int @default(0)
  nivelEnergia           Int @default(0)
  motivacionDinero       Int @default(0)
  posibilidadPermanencia Int @default(0)

  // Valores (1–5)
  imagenProfesional Int @default(0)
  enfoqueSocial     Int @default(0)
  autoGestionable   Int @default(0)
  orientadoProcesos Int @default(0)
  claridadMetas     Int @default(0)
  enfoqueActividad  Int @default(0)

  vitalesCompletadosEn DateTime?
  valoresCompletadosEn DateTime?
  creadoEn             DateTime  @default(now())
  actualizadoEn        DateTime  @updatedAt
}

model Venta {
  id                   String            @id @default(cuid())
  asesorId             String
  asesor               Usuario           @relation("ventasAsesor", fields: [asesorId], references: [id])
  clienteId            String
  cliente              Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ramo                 RamoSeguro
  producto             String
  // Producto del catálogo NYL (opcional pero recomendado)
  productoCatalogoId   String?
  productoCatalogo     ProductoCatalogo? @relation(fields: [productoCatalogoId], references: [id])
  // SIEMPRE en MXN — es el campo que suman métricas, comisiones, metas y
  // ranking. Si la póliza está en USD/UDI, aquí va ya convertido.
  primaAnual           Float
  // Denominación original de la póliza (lo que dice el contrato).
  moneda               MonedaPoliza      @default(MXN)
  // Monto en la moneda original y tipo de cambio usado. Solo informativos:
  // ningún cálculo de negocio los lee, para no duplicar definiciones.
  primaMoneda          Float?
  tipoCambio           Float?
  comisionPct          Float             @default(10)
  comisionMonto        Float?
  estado               EstadoVenta       @default(PENDIENTE_PAGAR)
  validadoPor          String?
  validador            Usuario?          @relation("ventasValidador", fields: [validadoPor], references: [id])
  fechaValidacion      DateTime?
  // Pipeline financiero: fechas y flags
  fechaFirma           DateTime?
  // Cuándo la aseguradora emitió la póliza — distinta de la fecha de firma
  // (el cliente firma la solicitud, la compañía emite días o semanas después).
  fechaEmision         DateTime?
  fechaPago            DateTime?
  fechaEntregaPoliza   DateTime?
  fechaCancelacion     DateTime?
  montoCancelado       Float?
  motivoCancelacion    String?
  // Vigencia y pagos subsecuentes (recordatorios automáticos)
  formaPago            FormaPago         @default(ANUAL)
  // Cargo automático: si es true NO se generan recordatorios de cobro (el
  // dinero se retira solo; recordarlo sería ruido para el asesor).
  domiciliada          Boolean           @default(false)
  metodoPago           MetodoPagoPoliza?
  fechaInicioVigencia  DateTime?
  fechaFinVigencia     DateTime?
  fechaProximoPago     DateTime?
  diaPago              Int? // día del mes para cobros recurrentes (1-28)
  montoPago            Float? // monto de cada pago recurrente (proporcional de primaAnual)
  // Moneda en que se capturó `montoPago`. A diferencia de primaAnual (que
  // SIEMPRE queda en MXN porque la suman las métricas), el monto del recibo es
  // informativo para el asesor y el cliente: si la póliza se cobra en dólares,
  // el recibo dice dólares y se guarda tal cual, con su equivalente calculado
  // al vuelo para mostrar.
  montoPagoMoneda      MonedaPoliza      @default(MXN)
  // Detalle técnico de la póliza (ficha)
  sumaAsegurada        Float?
  // Moneda en que se capturó sumaAsegurada (sigue la moneda de la póliza,
  // igual que primaMoneda: es una copia informativa, no hay conversión
  // automática — si la póliza está en UDIS/USD, el número ya está en esa
  // denominación y no se convierte a MXN como sí pasa con la prima).
  sumaAseguradaMoneda  MonedaPoliza      @default(MXN)
  // Tipo de cambio con el que se mostró el equivalente en pesos de la suma
  // asegurada al capturarla (Banxico del día). Es una FOTO informativa, igual
  // que `tipoCambio` para la prima: ningún cálculo de negocio lo lee — la suma
  // asegurada no alimenta métricas ni comisiones. Sirve para saber a qué
  // paridad se le enseñó la cifra al cliente.
  sumaAseguradaTC      Float?
  plazo                String? // ej. "20 pagos", "Anual renovable"
  deducible            Float? // GMM / Salud
  // Moneda del deducible: en GMM internacional (Alfa Medical Internacional) el
  // deducible viene en dólares, no en pesos.
  deducibleMoneda      MonedaPoliza      @default(MXN)
  coaseguro            String? // GMM / Salud, ej. "10%"
  // PDF de la póliza escaneada/emitida por la compañía, subido desde "Nueva
  // póliza" → "Subir documento". Reusa DocumentoCliente (mismo /uploads,
  // mismo visor) en vez de duplicar el manejo de archivos; 1:1 porque cada
  // póliza tiene a lo más un documento oficial adjunto (no un historial de
  // versiones). Documentos previos sin analizar (subidos antes de esta
  // función) simplemente no tienen este vínculo.
  documentoPolizaId    String?           @unique
  documentoPoliza      DocumentoCliente? @relation(fields: [documentoPolizaId], references: [id], onDelete: SetNull)
  // Diagnóstico de la extracción con IA sobre documentoPoliza: cuándo corrió,
  // qué modelo, y si el asesor llegó a confirmar el formulario prellenado.
  // No son datos de negocio — nadie más los lee; sirven para saber si vale
  // la pena reintentar una extracción fallida o floja.
  extraccionEn         DateTime?
  extraccionModelo     String?
  extraccionConfirmada Boolean           @default(false)
  // [{ nombre, detalle?, monto?, costo?, costoMoneda? }] — `monto` es texto
  // libre de la suma asegurada de esa cobertura ("$800,000", "Incluida",
  // "10%"); `costo` es el costo extra numérico de contratarla (null/0 = va
  // incluida) y `costoMoneda` la denominación de ese costo (default MXN si
  // falta, que es como se guardaron las coberturas anteriores a multi-moneda).
  coberturas           Json?
  // [{ nombre, porcentaje? }]
  beneficiarios        Json?
  notas                String?
  creadoEn             DateTime          @default(now())
  actualizadoEn        DateTime          @updatedAt

  recordatoriosPago Nota[]
  pagos             PagoPoliza[]

  @@index([asesorId])
  @@index([clienteId])
  @@index([estado])
}

// Historial de cobros de una póliza. Antes un pago solo dejaba rastro como
// nota completada, así que no había de dónde sacar el semáforo por cliente ni
// se podía registrar que el cliente pagó un monto distinto al esperado.
model PagoPoliza {
  id            String           @id @default(cuid())
  ventaId       String
  venta         Venta            @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  // Periodo que cubre este pago (la fechaProximoPago que estaba vigente).
  periodo       DateTime
  fechaPago     DateTime         @default(now())
  estado        EstadoPagoPoliza @default(PAGADO)
  montoEsperado Float?
  montoPagado   Float?
  // Requerida por la UI solo cuando montoPagado != montoEsperado.
  justificacion String?
  registradoPor String?
  registrador   Usuario?         @relation("pagosRegistrados", fields: [registradoPor], references: [id])
  creadoEn      DateTime         @default(now())

  @@index([ventaId, periodo])
}

// Eventos de actividad estructurados: tipo canónico (ver TIPOS_ACTIVIDAD en
// src/utils/actividad.js) + metadata con los datos del evento. El texto visible
// se arma en el frontend; descripcion solo queda como fallback de eventos
// históricos que se guardaron ya renderizados.
model Actividad {
  id          String   @id @default(cuid())
  asesorId    String
  asesor      Usuario  @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  tipo        String
  descripcion String?
  metadata    Json?
  creadoEn    DateTime @default(now())

  @@index([asesorId, creadoEn])
}

// Meta individual por asesor y mes, en 6 métricas. Los actuales se calculan
// en el backend (GET /targets/resumen) contra los registros del periodo:
// ventas APROBADA/PAGADA (misma definición de "ganado" que Pólizas), citas
// COMPLETADA, clientes creados (no archivados), referidos y actividades LLAMADA.
model Target {
  id                String   @id @default(cuid())
  asesorId          String
  asesor            Usuario  @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  mes               Int
  anio              Int
  metaVentasNum     Int?
  metaPrimaMonto    Float?
  metaCitasNum      Int? // citas COMPLETADA del mes
  metaProspectosNum Int? // clientes nuevos creados en el mes
  metaReferidosNum  Int? // referidos registrados en el mes
  metaLlamadasNum   Int? // actividades tipo LLAMADA del mes
  metaIngresoMonto  Float? // meta de ingreso (comisión) mensual deseada, ej. $60,000 MXN (PRP,
  // 2026-08-05). Personal, no existe a nivel equipo. El backend la traduce a
  // "pólizas necesarias" usando la comisión promedio histórica del propio
  // asesor (GET /targets/resumen) — no es una meta más a sumar/reconciliar
  // contra TargetEquipo como las otras 6.
  creadoEn          DateTime @default(now())

  @@unique([asesorId, mes, anio])
}

// Meta de promotoría (objetivo agregado de todo el equipo) por mes/año.
// Las metas individuales (Target) se reconcilian contra esta: la UI muestra
// la diferencia entre la suma de individuales y la meta de equipo.
model TargetEquipo {
  id                String   @id @default(cuid())
  mes               Int
  anio              Int
  metaVentasNum     Int?
  metaPrimaMonto    Float?
  metaCitasNum      Int?
  metaProspectosNum Int?
  metaReferidosNum  Int?
  metaLlamadasNum   Int?
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  @@unique([mes, anio])
}

// Notas + Recordatorios unificados. Los recordatorios tienen fechaAviso
// y disparan una notificación push al asesor cuando alcanzan su fecha.
// tipo=RECORDATORIO_PAGO se asocia a una Venta (póliza) para pagos subsecuentes.
model Nota {
  id                  String           @id @default(cuid())
  // Sujeto de la nota: un cliente O un candidato a asesor, nunca ambos ni
  // ninguno (excluyentes, mismo criterio que Cita.clienteId/candidatoId;
  // validado en routes/notas.js). `clienteId` dejó de ser obligatorio al
  // abrirse los recordatorios al módulo de reclutamiento.
  clienteId           String?
  cliente             Cliente?         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  candidatoId         String?
  candidato           Candidato?       @relation("notasSeguimiento", fields: [candidatoId], references: [id], onDelete: Cascade)
  asesorId            String
  asesor              Usuario          @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  tipo                TipoNota         @default(NOTA)
  // Segmenta el recordatorio: gestión propia del asesor vs. algo que hay que
  // tratar con el cliente. Ambos le llegan al asesor (no hay canal al cliente).
  destinatario        DestinatarioNota @default(ASESOR)
  texto               String
  // Solo para RECORDATORIO / RECORDATORIO_PAGO: cuándo debe avisarse
  fechaAviso          DateTime?
  completada          Boolean          @default(false)
  // Aviso del día: ya se generó la notificación de `fechaAviso`
  notificacionEnviada Boolean          @default(false)
  // Aviso anticipado: ya se generó la notificación de 1 día antes. Son dos
  // banderas y no un contador porque las dos ventanas son independientes (un
  // recordatorio creado con menos de 24h de anticipación solo dispara la del día).
  avisoPrevioEnviado  Boolean          @default(false)
  // Solo RECORDATORIO_PAGO:_venta asociada a la póliza
  ventaId             String?
  venta               Venta?           @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  creadoEn            DateTime         @default(now())
  actualizadoEn       DateTime         @updatedAt

  @@index([asesorId, fechaAviso])
  @@index([clienteId])
  @@index([candidatoId])
  @@index([ventaId])
}

// Catálogo de productos de Seguros Monterrey New York Life.
// Poblado por la promotora desde los PDFs/documentos oficiales.
model ProductoCatalogo {
  id              String     @id @default(cuid())
  ramo            RamoSeguro
  nombre          String
  codigo          String? // código interno de la aseguradora (opcional pero recomendable)
  descripcion     String?
  comisionPct     Float? // comisión sugerida para asesores (% de la prima anual)
  comisionBonoPct Float? // % de comisión adicional porcentaje de bono si aplica
  coberturas      Json? // [{nombre, detalle, monto}] — plantilla para autocompletar Venta.coberturas
  // Monedas en que la compañía ofrece el producto, ej. ["USD","UDI"].
  // Solo sugiere la moneda al crear la póliza (Venta.moneda manda).
  monedas         Json?
  activo          Boolean    @default(true)
  creadoEn        DateTime   @default(now())
  actualizadoEn   DateTime   @updatedAt

  ventas Venta[]

  @@unique([ramo, nombre])
}

// Archivo adjunto a la ficha de un cliente (identificación, solicitud, póliza escaneada, etc.).
// El archivo físico vive en backend/uploads; aquí solo se guarda la referencia.
model DocumentoCliente {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  asesorId  String
  asesor    Usuario  @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  nombre    String // nombre original del archivo
  archivo   String // nombre físico dentro de /uploads
  mime      String?
  tamano    Int      @default(0) // bytes
  creadoEn  DateTime @default(now())

  // Presente solo si este documento es el PDF oficial de una póliza (subido
  // desde "Nueva póliza" → "Subir documento", no desde la ficha del cliente).
  ventaPoliza Venta?

  @@index([clienteId])
}

// Relación explícita de referidos: cliente A refiere a cliente B.
//cobra cada referido puede tener un estado (pendiente, contactado, convertido)
model Referido {
  id                String   @id @default(cuid())
  asesorId          String
  asesor            Usuario  @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  clienteOrigenId   String
  clienteOrigen     Cliente  @relation("ReferidosOrigen", fields: [clienteOrigenId], references: [id], onDelete: Cascade)
  clienteReferidoId String?
  clienteReferido   Cliente? @relation("ReferidosCliente", fields: [clienteReferidoId], references: [id], onDelete: SetNull)
  // Para referidos que aún no son cliente (solo se tiene nombre/teléfono)
  nombreReferido    String?
  telefonoReferido  String?
  emailReferido     String?
  estado            String   @default("PENDIENTE") // PENDIENTE, CONTACTADO, CONVERTIDO, DESCARTADO
  fecha             DateTime @default(now())
  notas             String?
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  @@index([asesorId, estado])
  @@index([clienteOrigenId])
}

// ——— Sistema de 25 puntos (formato semanal SMNYL) ———
// Registro DIARIO de actividad comercial por asesor. El puntaje NO se guarda:
// se calcula en servidor con el mapa único PUNTOS de routes/puntos.js
// (referido obtenido=3, llamada=1, cita obtenida=2, cuestionario=2, cierre=3,
// solicitud=5; meta = 25 puntos diarios). No duplicar esa tabla de valores.
model RegistroPuntos {
  id                      String   @id @default(cuid())
  asesorId                String
  asesor                  Usuario  @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  fecha                   DateTime @db.Date
  // Áreas de prospección
  referidosObtenidos      Int      @default(0)
  referidosContactados    Int      @default(0)
  llamadasRealizadas      Int      @default(0)
  citasObtenidas          Int      @default(0)
  // Áreas de alta productividad (planeado vs realizado)
  citasPlaneadas          Int      @default(0)
  citasNuevas             Int      @default(0)
  cuestionariosPlaneados  Int      @default(0)
  cuestionariosRealizados Int      @default(0)
  cierresPlaneados        Int      @default(0)
  cierresRealizados       Int      @default(0)
  // Resultados
  solicitudes             Int      @default(0)
  comision                Float    @default(0)
  creadoEn                DateTime @default(now())
  actualizadoEn           DateTime @updatedAt

  @@unique([asesorId, fecha])
}

// Listas de planeación del formato de 25 puntos, por semana (lunes como
// inicio, misma convención que el resto del sistema). Cada lista es un Json
// de hasta 5 strings.
model PlanSemanal {
  id                    String   @id @default(cuid())
  asesorId              String
  asesor                Usuario  @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  semanaInicio          DateTime @db.Date
  mejoresProspectos     Json?
  desarrolloPersonal    Json?
  oportunidadesVenta    Json?
  oportunidadesServicio Json?
  creadoEn              DateTime @default(now())
  actualizadoEn         DateTime @updatedAt

  @@unique([asesorId, semanaInicio])
}

// ——— Clínica telefónica (Evaluador de Prospectos) ———
// Fila del formato semanal "Evaluador de Prospectos" (diseñado para conseguir
// 10 citas a la semana): lista de contactos a calificar/llamar en la clínica.
model ProspectoClinica {
  id              String    @id @default(cuid())
  asesorId        String
  asesor          Usuario   @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  semanaInicio    DateTime  @db.Date
  nombre          String
  contacto        String? // teléfono o "contacto personal"
  parentesco      String?
  edad            Int?
  estadoCivil     String? // incluye cónyuge (texto libre, como el formato)
  ocupacion       String?
  dependientes    String? // nombre y edad de los hijos (texto libre)
  tieneSeguro     Boolean?
  fechaEntrevista DateTime?
  planSeguimiento String?
  resultado       String    @default("PENDIENTE") // PENDIENTE, CONTACTADO, CITA_OBTENIDA, CONVERTIDO, DESCARTADO
  // Si el prospecto se convirtió en cliente del CRM
  clienteId       String?
  cliente         Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt

  @@index([asesorId, semanaInicio])
}

// Sesión de clínica telefónica realizada (la meta operativa es ~2 por semana):
// cuántas llamadas se hicieron y cuántas citas se obtuvieron en la sesión.
model SesionClinica {
  id             String   @id @default(cuid())
  asesorId       String
  asesor         Usuario  @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  fecha          DateTime
  llamadas       Int      @default(0)
  citasObtenidas Int      @default(0)
  notas          String?
  creadoEn       DateTime @default(now())

  @@index([asesorId, fecha])
}

// Bono de producción del asesor, separado por período (mes/año).
// Estado: PENDIENTE (por ganar) o COBRADO.
model Bono {
  id            String    @id @default(cuid())
  asesorId      String
  asesor        Usuario   @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  mes           Int
  anio          Int
  concepto      String // ej: "Bono de producción", "Bono de persistencia", "Bono nuevo asesor"
  monto         Float     @default(0)
  estado        String    @default("PENDIENTE") // PENDIENTE (por ganar) o COBRADO
  fechaCobro    DateTime?
  notas         String?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@unique([asesorId, mes, anio, concepto])
  @@index([asesorId, estado])
}
